<?xml version="1.0" encoding="utf-8"?>
<!-- Detaydaki fragman (TvTrailerActivity): TextureView (SurfaceView bu kutuda ekranı beyaz bırakıyordu), kumandayla açılan
     oynatıcı çubuğu, görüntü ekrana sığdırılır. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    app:surface_type="texture_view"
    app:use_controller="true"
    app:show_buffering="when_playing"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black" />
