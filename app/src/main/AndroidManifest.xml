<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- İndirme (Faz 4/B): ön plan servisi (Android 14+ için veri senkronu türü), Android 13+ bildirim izni, iş zamanlayıcının
         yeniden başlatmada kalıcı olması. Bildirim izni reddedilse de indirme çalışır. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Uygulama içi güncelleme: indirilen APK için sistem kurulum ekranını açar (Android 8+ ayrıca "bilinmeyen kaynaklar" izni ister). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android TV/kumanda: dokunmatik ekran ve leanback zorunlu değil, aynı APK telefon, tablet ve TV'de kurulur. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".PlayApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Play"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TV ana ekranı: banner ile Play kutusu çıkar. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- https://.../manifest.json bağlantıları uygulamayı açıp "eklenti ekle" akışını başlatır. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*/manifest\\.json" />
            </intent-filter>

            <!-- play://add?repo=<adres> ve play://add?nuvio=<adres>: depo/eklenti ekleme bağlantısı. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="play" android:host="add" />
            </intent-filter>
        </activity>

        <!-- Tam ekran yatay oynatıcı; kaynak seçiminden PlaySession ile açılır. -->
        <!-- YouTube fragmanını Compose AndroidView yüzeyi dışında oynatır. -->
        <activity
            android:name=".ui.detail.YouTubeTrailerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- Reklamsız web görünümü; Ayarlar > Eklentiler > Web siteleri'nden adres verilerek açılır. -->
        <activity
            android:name=".ui.web.WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false" />

        <!-- Cloudflare Turnstile / interaktif bot doğrulama ekranı -->
        <activity
            android:name=".ui.cloudflare.CloudflareVerifyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false" />

        <!-- İndirme servisi: ilerleme bildirimiyle ön planda çalışır; ağ koşulu sağlanınca zamanlayıcı yeniden başlatır. -->
        <service
            android:name=".data.download.PlayDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Güncelleme APK'sını sistem kurulum ekranına vermek için (yalnızca cache/updates, bkz. res/xml/update_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Uygulama içi güncelleme indirmesi: ilerleme bildirimiyle ön planda sürer (uygulamadan çıkılsa da kesilmez). -->
        <service
            android:name=".data.update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- API 33 öncesinde uygulama başına dil seçimini AppCompat'in kalıcı tutması için. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
